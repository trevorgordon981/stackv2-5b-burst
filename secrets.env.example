# Copy to `secrets.env` (gitignored — NEVER commit secrets.env).
# Required for BURST_MODE=nas (remote NAS over Tailscale + SSH):
TS_AUTHKEY=tskey-auth-REPLACE_ME
NAS_HOST=nas.example.ts.net
NAS_USER=burst-user
NAS_DATA=/srv/datasets/the-stack-v2-content
NAS_CKPT=/srv/checkpoints/stackv2-5b-burst

# Optional SSH deploy key (required if the NAS uses key-only sshd instead of Tailscale SSH):
# NAS_KEY=$HOME/.ssh/nas_deploy_key

# Optional handoff pinning (recommended for every burst):
# EXPECTED_STEP=1000
# EXPECTED_GENERATION=gen_00001000_abcdef123456
# EXPECTED_SHA256=

# Optional staging host variables for stage-ckpt.sh:
# PRIMARY_HOST=user@primary-gpu.example.ts.net
# PRIMARY_CKPT_DIR=/srv/runs/stackv2-5b
# NAS_CKPT_DIR=/srv/checkpoints/stackv2-5b-burst
